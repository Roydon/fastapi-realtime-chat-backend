# Copy to .env (`make up` does this automatically). Values below are for local development only.

# --- core ---
LOG_LEVEL=INFO
LOG_JSON=true
DATABASE_URL=postgresql+asyncpg://chat:chat@postgres:5432/chat
REDIS_URL=redis://redis:6379/0

# --- auth ---
# hs256: shared secret (demo). jwks: verify tokens from your identity provider.
AUTH_MODE=hs256
JWT_SECRET=local-dev-only-secret-change-me-0123456789abcdef
# JWKS_URL=https://your-idp.example.com/.well-known/jwks.json
# JWT_ALGORITHMS=RS256
# JWT_ISSUER=https://your-idp.example.com/
# JWT_AUDIENCE=chat-api
JWT_USER_CLAIM=sub

# --- attachments (MinIO locally, S3 in AWS) ---
S3_ENDPOINT_URL=http://minio:9000
# The address browsers use to reach the bucket (nginx proxies /chat-attachments/ to MinIO).
S3_PUBLIC_ENDPOINT_URL=http://localhost:8080
S3_BUCKET=chat-attachments
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin-local-only
ATTACHMENT_MAX_BYTES=5242880

# --- demo ---
# Serves /demo/ and a token endpoint for users alice and bob. Never enable in production.
DEMO_ENABLED=true

# --- postgres / minio containers ---
POSTGRES_USER=chat
POSTGRES_PASSWORD=chat
POSTGRES_DB=chat
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin-local-only
